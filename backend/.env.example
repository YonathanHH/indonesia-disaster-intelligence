DATABASE_URL=sqlite+aiosqlite:///./bmkgintel.db
# For production Postgres+PostGIS:
# DATABASE_URL=postgresql+asyncpg://bmkg:bmkg@localhost:5432/bmkgintel
BMKG_HTTP_TIMEOUT=15
INGEST_INTERVAL_SECONDS=300
# Optional AI rephrase via OpenRouter (https://openrouter.ai/keys).
# Defaults to the free router; pin a specific free model if you prefer,
# e.g. OPENROUTER_MODEL=z-ai/glm-5.2:free (see https://openrouter.ai/models?pricing=free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NEXT_PUBLIC_API_URL=http://localhost:8000
