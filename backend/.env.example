DATABASE_URL=sqlite+aiosqlite:///./bmkgintel.db
# For production Postgres+PostGIS:
# DATABASE_URL=postgresql+asyncpg://bmkg:bmkg@localhost:5432/bmkgintel
BMKG_HTTP_TIMEOUT=15
INGEST_INTERVAL_SECONDS=300
# Optional AI rephrase via OpenRouter (https://openrouter.ai/keys).
# Defaults to the free router; pin a specific free model if you prefer,
# e.g. OPENROUTER_MODEL=z-ai/glm-5.2:free (see https://openrouter.ai/models?pricing=free).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# --- scheduled jobs (Vercel) ---
# Vercel Cron sends this as `Authorization: Bearer <value>`; generate a random
# string of 16+ chars. Jobs return 401 when it is unset.
CRON_SECRET=
# Gates mutating endpoints (POST /events/{id}/resolve). Not used by the public UI.
OPERATOR_SECRET=
# Comma-separated browser origins allowed cross-origin access. Leave empty when
# the dashboard and API share one origin (the Vercel Services default).
ALLOWED_ORIGINS=
# Minimum seconds between two executive-brief rebuilds.
BRIEF_MIN_REBUILD_SECONDS=900
