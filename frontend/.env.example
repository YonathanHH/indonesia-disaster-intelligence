# Leave empty to use the Next.js proxy: the browser calls /api/v1/* on :3000
# and Next forwards it to FastAPI on :8000 (started automatically by `next dev`).
# Set an absolute URL only if you want the browser to call the backend directly.
NEXT_PUBLIC_API_URL=

# Optional dev overrides:
# BACKEND_INTERNAL_URL=http://127.0.0.1:8000  # where Next proxies /api/v1/*
# BACKEND_PORT=8000                           # port the auto-started API uses
# DEV_BACKEND=0                               # skip auto-starting the API
